# Interface definition for thorn CapyrX_TestMultiPatch

IMPLEMENTS: CapyrX_TestMultiPatch

INHERITS: CoordinatesX MultiPatch

USES INCLUDE HEADER: loop_device.hxx
USES INCLUDE HEADER: global_derivatives.hxx

# Determine which of a patch's faces border another patch
CCTK_INT FUNCTION MultiPatch_GetBoundarySpecification2( \
  CCTK_INT IN patch, \
  CCTK_INT IN size, \
  CCTK_INT OUT ARRAY is_interpatch_boundary)
USES FUNCTION MultiPatch_GetBoundarySpecification2

CCTK_REAL test_data TYPE=gf TAGS='dependents="error" dirichlet_values={1138.0 1138.0 1138.0}'
{
    u
} "Test grid functions"

CCTK_REAL error TYPE=gf
{
  interp
  dfdx
  dfdy
  dfdz
  d2fdx2
  d2fdy2
  d2fdz2
  d2fdxy
  d2fdxz
  d2fdyz
} "Test grid function error"

CCTK_REAL color TYPE=gf
{
    color
} "Patch colors, for testing interpolation sources and targets"

CCTK_REAL color_pre TYPE=gf
{
    color_pre
} "Snapshot of patch colors taken before interpatch SYNC; never itself synced"

# nan_test, nan_test_pre, smooth_test and smooth_test_pre used to be declared
# here and were written only by the two outer-boundary diagnostics, which
# `run_outer_bc_tests` switched off by default.  CarpetX allocates a MultiFab
# for every DECLARED grid function whether or not any thorn asks for storage,
# and it requires every one of them to be valid before it creates a refined
# level, so four fields nothing wrote made every par file of this thorn --
# the coloring test included -- abort at "MakeNewLevelFromCoarse before
# prolongation" as soon as CarpetX::max_num_levels > 1.  They now live in
# CapyrX_TestOuterBC, whose activation is the switch.  This thorn declares
# only groups it always writes.
