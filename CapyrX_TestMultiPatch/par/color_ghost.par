# Same problem as color.par, but with max_grid_size small enough (patch
# gsh is [13,13,13]/[13,13,21]) that AMReX is forced to split every patch
# into multiple boxes. The point is to make grid.loop_ghosts_device
# (CapyrX_TestMultiPatch/src/testmultipatch.cxx) actually fire: it only
# visits faces where AMReX's bbox flag is false, i.e. genuine intra-patch,
# box-to-box faces -- with the default max_grid_size=32 every patch here is
# a single box, so that loop never runs (see coloring_0.md). See coloring_1.md
# for the writeup of what this variant actually exercises.

ActiveThorns = "
    CarpetX
    IOUtil
    CoordinatesX
    CapyrX_MultiPatch
    CapyrX_TestMultiPatch
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_show_schedule = yes

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 0

CarpetX::verbose                 = yes
CarpetX::poison_undefined_values = yes

CarpetX::ghost_size          = 2
CarpetX::interpolation_order = 0

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

CarpetX::max_grid_size_x = 4
CarpetX::max_grid_size_y = 4
CarpetX::max_grid_size_z = 4

CapyrX_MultiPatch::verbose        =  yes
CapyrX_MultiPatch::patch_system   = "Cubed sphere"
CapyrX_MultiPatch::inner_boundary_radius = 0.5
CapyrX_MultiPatch::outer_boundary_radius = 2.5
CapyrX_MultiPatch::angular_cells         = 8
CapyrX_MultiPatch::radial_cells          = 16
CapyrX_MultiPatch::patch_overlap         = 0

CarpetX::boundary_x       = "dirichlet"
CarpetX::boundary_y       = "dirichlet"
CarpetX::boundary_z       = "dirichlet"
CarpetX::boundary_upper_x = "dirichlet"
CarpetX::boundary_upper_y = "dirichlet"
CarpetX::boundary_upper_z = "dirichlet"

IO::parfile_write = no
IO::out_dir       = $parfile
IO::out_every     = 1

CarpetX::out_performance = no
CarpetX::out_metadata    = no

CarpetX::out_tsv = yes
CarpetX::out_tsv_vars = "
  CoordinatesX::vertex_coords
  CapyrX_TestMultiPatch::color
  CapyrX_TestMultiPatch::color_pre
"
