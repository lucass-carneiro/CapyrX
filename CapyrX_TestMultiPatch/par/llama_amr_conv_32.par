# Llama WaveToy with CUBE-ONLY AMR -- convergence base N=32 (to t=2.0).
#
# Step 14 of llama_patch_system_impl.md (Phase D: AMR convergence + the [P453]
# side-step). This is the coarse base of the two-base AMR-vs-unigrid convergence
# measurement: it is llama_amr_32.par (Step 13's structural cube-AMR run) evolved
# to the SAME physical time t = 2.0 as the unigrid reference llama_wave_32.par, so
# the two can be differenced pointwise at coincident level-0 vertices. The order
# of ||phi_AMR(N) - phi_unigrid(N)|| across N = 32, 64 (see llama_amr_conv_64.par)
# is the evolution order if and only if the cube refinement preserves accuracy
# across BOTH the refinement boundary (the level-0/level-1 interface at |coord| ~
# 0.4) and the patch boundary (the cube<->wedge seam at r = R). scripts/
# check_amr_conv.py reads the level-0 `state` and fits the order globally and in
# those two bands.
#
# WHY itlast = 256 AND NOT 128. With max_num_levels = 2, CarpetX sets the timestep
# from the FINEST level's spacing: dt = dtfac * dx_level1 = dtfac * dx_cube / 2
# (verified -- Step 13's llama_amr_32.par at it128 lands on t = 1.0, not t = 2.0 as
# its header text wrongly assumed; CarpetX does global, not subcycled, time
# stepping). So to reach the unigrid's t = 2.0 the AMR run needs twice the
# iterations: dt = 0.25 * (2/32) / 2 = 0.0078125, 256 * 0.0078125 = 2.0. The
# unigrid llama_wave_32.par (max_num_levels = 1) reaches t = 2.0 in 128 steps
# because its dt is the un-halved coarse value.
#
# WHY N >= 32 FOR CUBE AMR (same as Step 13). The refined box must clear the cube's
# interpatch DONOR ZONE (the band ~(patch_overlap + ghost_width + 2) ~ 7 cells
# inward of r = R from which the wedges draw their inner-radial ghosts) or
# CarpetX's C-AMR2 contract aborts. At N = 32 (dx = 0.0625) that zone occupies ~7
# of 16 half-cube cells, so a radius-0.4 box clears it with margin; the same
# radius-0.4 box clears it at every finer N, so this and llama_amr_conv_64.par
# reuse it unchanged.
#
# CONFINEMENT AND REPAIR (R4) as in Step 13: BoxInBox_Setup refines patch 0 (the
# cube) only, so the six Thornburg wedges stay unigrid; regrid_interpatch_repair
# re-fills the inter-patch ghosts after every regrid, and poison_undefined_values
# = yes turns any un-refilled ghost into a loud abort, so a clean completion is the
# "ghosts re-filled after regrid" gate.
#
# [P453] SIDE-STEP. The whole run uses slave_overlap = no (the Step 5 Llama guard
# forbids yes). [P453] is that slave_overlap = yes kills an AMR evolution; the
# Llama system couples patches through a dual-evolved overlap band instead, so a
# stable, convergent AMR run here side-steps [P453] by construction.

ActiveThorns = "
    ADMBaseX
    BoxInBox
    CarpetX
    IOUtil
    ODESolvers
    CoordinatesX
    CapyrX_MultiPatch
    CapyrX_WaveToy
"

$cfl = 0.25

Cactus::presync_mode       = "mixed-error"
Cactus::cctk_show_schedule = no

CarpetX::verbose                 = no
CarpetX::poison_undefined_values = yes

CarpetX::ghost_size          = 3
CarpetX::interpolation_order = 4

# Prolongation order at the coarse-fine (refinement) boundary. The CarpetX default
# is 1 (linear, O(h^2)) -- far too low for a 4th-order evolution: it caps the
# AMR-vs-unigrid convergence at ~2 regardless of the FD/interpatch order. 5 is the
# value every production CanudaX BSSN parfile uses, and it restores the evolution
# order across the refinement boundary (the AMR analogue of interpolation_order for
# the interpatch seam). Its 6-point stencil (half-width 3) fits ghost_size = 3.
CarpetX::prolongation_order = 5

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

ODESolvers::method = "RK4"
CarpetX::dtfac     = $cfl

CapyrX_MultiPatch::verbose        = no
CapyrX_MultiPatch::patch_system   = "Llama"
CapyrX_MultiPatch::patch_overlap  = 2
CapyrX_MultiPatch::slave_overlap  = no

CapyrX_MultiPatch::inner_boundary_radius = 1.0
CapyrX_MultiPatch::outer_boundary_radius = 4.0
CapyrX_MultiPatch::angular_cells         = 32
CapyrX_MultiPatch::radial_cells          = 48
CapyrX_MultiPatch::cartesian_ncells_i    = 32
CapyrX_MultiPatch::cartesian_ncells_j    = 32
CapyrX_MultiPatch::cartesian_ncells_k    = 32

CapyrX_WaveToy::initial_condition = "Gaussian"
CapyrX_WaveToy::amplitude         = 1.0
CapyrX_WaveToy::gaussian_width    = 0.5
CapyrX_WaveToy::gaussian_R0       = 0.0
CapyrX_WaveToy::add_dissipation       = yes
CapyrX_WaveToy::cart_diss_eps         = 0.15
CapyrX_WaveToy::curv_diss_eps_a       = 0.15
CapyrX_WaveToy::curv_diss_eps_b       = 0.15
CapyrX_WaveToy::curv_diss_eps_c       = 0.15
CapyrX_WaveToy::diss_max_step_damping = 1.0
CapyrX_WaveToy::use_newradx           = no

CarpetX::boundary_x       = "linear extrapolation"
CarpetX::boundary_y       = "linear extrapolation"
CarpetX::boundary_z       = "linear extrapolation"
CarpetX::boundary_upper_x = "linear extrapolation"
CarpetX::boundary_upper_y = "linear extrapolation"
CarpetX::boundary_upper_z = "linear extrapolation"

# ---- cube-only AMR ----------------------------------------------------------
CarpetX::max_num_levels = 2
CarpetX::regrid_every   = 16

BoxInBox::num_regions  = 1
BoxInBox::shape_1      = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::position_x_1 = 0.0
BoxInBox::position_y_1 = 0.0
BoxInBox::position_z_1 = 0.0
BoxInBox::radius_1     = [
  -1.0,
  0.4
]

Cactus::terminate   = "iteration"
Cactus::cctk_itlast = 256

IO::parfile_write = no
IO::out_dir       = $parfile
IO::out_every     = 256

CarpetX::out_performance = no
CarpetX::out_metadata    = no

CarpetX::out_tsv       = yes
CarpetX::out_tsv_every = 256
CarpetX::out_tsv_vars  = "
  CoordinatesX::vertex_coords
  CapyrX_WaveToy::state
"
