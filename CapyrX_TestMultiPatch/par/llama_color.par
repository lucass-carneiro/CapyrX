# Llama ownership test: one interpatch SYNC of the `owner` marker, then every
# ghost's decoded owner is checked against geometric ownership (scripts/
# check_color.py --owner). The Llama Check_Parameters guard forbids
# interpolation_order 0, so the two-digit `color` field (which only decodes
# cleanly at order 0) cannot be used here -- `owner` holds 1 + patch on every
# valid cell and survives the order-4 interpatch interpolation intact.
#
# Faithful-Llama config (satisfies the Step 5 guards): patch_overlap = 2 =
# ceil(order/2), slave_overlap = no, interpolation_order = 4, ghost_size = 3,
# and sqrt(3)*R = 1.73 < outer = 4.0.

ActiveThorns = "
    CarpetX
    IOUtil
    CoordinatesX
    CapyrX_MultiPatch
    CapyrX_TestMultiPatch
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_show_schedule = yes

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 0

CarpetX::verbose                 = yes
CarpetX::poison_undefined_values = yes

CarpetX::max_num_levels = 1

CarpetX::ghost_size          = 3
CarpetX::interpolation_order = 4

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

CapyrX_MultiPatch::verbose        =  yes
CapyrX_MultiPatch::patch_system   = "Llama"
CapyrX_MultiPatch::patch_overlap  = 2
CapyrX_MultiPatch::slave_overlap  = no

CapyrX_MultiPatch::inner_boundary_radius = 1.0
CapyrX_MultiPatch::outer_boundary_radius = 4.0
CapyrX_MultiPatch::angular_cells         = 8
CapyrX_MultiPatch::radial_cells          = 8

CapyrX_MultiPatch::cartesian_ncells_i = 8
CapyrX_MultiPatch::cartesian_ncells_j = 8
CapyrX_MultiPatch::cartesian_ncells_k = 8

CarpetX::boundary_x       = "dirichlet"
CarpetX::boundary_y       = "dirichlet"
CarpetX::boundary_z       = "dirichlet"
CarpetX::boundary_upper_x = "dirichlet"
CarpetX::boundary_upper_y = "dirichlet"
CarpetX::boundary_upper_z = "dirichlet"

IO::parfile_write = no
IO::out_dir       = $parfile
IO::out_every     = 1

CarpetX::out_performance = no
CarpetX::out_metadata    = no

CarpetX::out_tsv = yes
CarpetX::out_tsv_vars = "
  CoordinatesX::vertex_coords
  CapyrX_TestMultiPatch::owner
"
