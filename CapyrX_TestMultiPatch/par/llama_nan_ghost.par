# Llama NaN-leak test, "ghost" injection -- the isolation (no-leak) case.
#
# NaN is written into every patch's genuine physical-outer ghost cells (the
# wedge high-radial face; the cube has no physical-outer face, so it is never
# injected -- MultiPatch_GetBoundarySpecification2 drives this, patch-system
# agnostically). A ghost cell is never a valid interpolation donor, so SYNC's
# interpatch interpolation cannot pull the injected NaN across any interpatch
# seam: check_nan_test.py must find zero LEAK-CROSS-PATCH (exit 0). This is the
# counterpart to the cubed_sphere nan_neumann_ghost_overlap_order4 cell.
#
# Faithful-Llama config (satisfies the Step 5 Check_Parameters guards):
# patch_overlap = 2 = ceil(order/2), slave_overlap = no, interpolation_order = 4,
# ghost_size = 3, and sqrt(3)*R = 1.73 < outer = 4.0. The Llama guard forbids
# interpolation_order < 4, so (unlike the cubed_sphere series) the leak threshold
# cannot be swept here; order 4 is the only legal order, and it is >= the order-1
# threshold, so this file's complement (llama_nan_interior) does leak.

ActiveThorns = "
    CarpetX
    IOUtil
    CoordinatesX
    CapyrX_MultiPatch
    CapyrX_TestMultiPatch
    CapyrX_TestOuterBC
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_show_schedule = yes

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 0

CarpetX::verbose = yes
# Deliberately off: CarpetX's check_valid_gf/check_valid_ga hardcode forbid_nans
# regardless of a group's checkpoint tag, so poison_undefined_values=yes aborts
# before SYNC runs. nan_test/nan_test_pre are self-written every cell and neither
# BC application nor MultiPatch_Interpolate branch on this flag, so turning it
# off changes no value this test compares (see mp_nan_test_1.md Sec 3).
CarpetX::poison_undefined_values = no

CarpetX::ghost_size          = 3
CarpetX::interpolation_order = 4

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

CapyrX_MultiPatch::verbose        = yes
CapyrX_MultiPatch::patch_system   = "Llama"
CapyrX_MultiPatch::patch_overlap  = 2
CapyrX_MultiPatch::slave_overlap  = no

CapyrX_MultiPatch::inner_boundary_radius = 1.0
CapyrX_MultiPatch::outer_boundary_radius = 4.0
CapyrX_MultiPatch::angular_cells         = 16
CapyrX_MultiPatch::radial_cells          = 16

CapyrX_MultiPatch::cartesian_ncells_i = 16
CapyrX_MultiPatch::cartesian_ncells_j = 16
CapyrX_MultiPatch::cartesian_ncells_k = 16

# Keep one AMReX box per patch at one rank. Each wedge is angular+2*overlap = 20
# cells in x/y and radial+overlap = 18 in z; the cube is cartesian+2*overlap = 20
# in every axis. max_grid_size = 20 on all axes covers the largest extent, so no
# patch is chopped (the interpatch geometry under test is then the clean
# single-box case).
CarpetX::max_grid_size_x = 20
CarpetX::max_grid_size_y = 20
CarpetX::max_grid_size_z = 20

CarpetX::amrex_parameters[0] = "amr.refine_grid_layout=0"
CarpetX::amrex_parameters[1] = "amr.v=2"

CarpetX::boundary_x       = "neumann"
CarpetX::boundary_y       = "neumann"
CarpetX::boundary_z       = "neumann"
CarpetX::boundary_upper_x = "neumann"
CarpetX::boundary_upper_y = "neumann"
CarpetX::boundary_upper_z = "neumann"

CapyrX_TestOuterBC::nan_injection_mode    = "ghost"
CapyrX_TestMultiPatch::run_outer_bc_tests = yes

IO::parfile_write = no
IO::out_dir       = $parfile
IO::out_every     = 1

CarpetX::out_performance = no
CarpetX::out_metadata    = no

CarpetX::out_tsv = yes
CarpetX::out_tsv_vars = "
  CoordinatesX::vertex_coords
  CapyrX_TestOuterBC::nan_test
  CapyrX_TestOuterBC::nan_test_pre
"
