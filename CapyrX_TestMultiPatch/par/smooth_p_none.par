# Smooth-field outer-BC (Channel 1) A/B test -- mp_noise_3.md sec 8.
#
# Run C: outer boundary = none. This is measurement (c), "exact-solution
# ghosts". write_smooth_test fills smooth with the exact analytic field
# EVERYWHERE, including the outer-BC ghosts (radial k=35,36). With boundary_* =
# none, CarpetX's BC pass is a no-op, so those outer ghosts KEEP their exact
# analytic values; the interpatch interpolation that fills a neighbouring
# wedge's near-outer corner ghosts then reads exact ghosts. Comparing this run
# against smooth_z_linextrap.par / smooth_z_neumann.par at the receiver cells
# isolates how much of the interpatch error comes from outer-BC ghost
# inaccuracy (Channel 1) vs. the interpolation stencil itself.
#
# IDENTICAL to smooth_z_neumann.par / smooth_z_linextrap.par except the
# CarpetX::boundary_* block. Interior bit-identical across all three runs.
# NOTE: "none" only disables the *physical outer* BC. The interpatch
# MultiPatch_Interpolate SYNC still runs and still fills the interpatch ghost
# faces -- exactly the cells this test measures. See scripts/check_smooth_test.py.

ActiveThorns = "
    CarpetX
    IOUtil
    CoordinatesX
    CapyrX_MultiPatch
    CapyrX_TestMultiPatch
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_show_schedule = yes

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 0

CarpetX::verbose                 = yes
CarpetX::poison_undefined_values = no

CarpetX::ghost_size          = 2
CarpetX::interpolation_order = 4

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

CapyrX_MultiPatch::verbose        =  yes
CapyrX_MultiPatch::patch_system   = "Cubed sphere"
CapyrX_MultiPatch::inner_boundary_radius = 0.5
CapyrX_MultiPatch::outer_boundary_radius = 2.5
CapyrX_MultiPatch::angular_cells         = 16
CapyrX_MultiPatch::radial_cells          = 32
CapyrX_MultiPatch::patch_overlap         = CarpetX::ghost_size

CarpetX::max_grid_size_x = CapyrX_MultiPatch::angular_cells + 2 * CapyrX_MultiPatch::patch_overlap
CarpetX::max_grid_size_y = CapyrX_MultiPatch::angular_cells + 2 * CapyrX_MultiPatch::patch_overlap
CarpetX::max_grid_size_z = CapyrX_MultiPatch::radial_cells + CapyrX_MultiPatch::patch_overlap

CarpetX::amrex_parameters[0] = "amr.refine_grid_layout=0"
CarpetX::amrex_parameters[1] = "amr.v=2"

# ---- The only block that differs between the three A/B par files ----
CarpetX::boundary_x       = "none"
CarpetX::boundary_y       = "none"
CarpetX::boundary_z       = "none"
CarpetX::boundary_upper_x = "none"
CarpetX::boundary_upper_y = "none"
CarpetX::boundary_upper_z = "none"
# --------------------------------------------------------------------

# With global boundary=none, CarpetX never fills OR marks-valid the physical
# outer boundary. `smooth`/`smooth_pre` are written EVERYWHERE (loop_all), so
# their outer boundary is validated by the write and this is harmless -- that
# is exactly what gives the exact-ghost (c) leg. BUT the co-scheduled
# interp-error test writes test_data(interior) only and relies on the outer BC
# to fill+validate its outer boundary; under global none, CarpetX's validity
# checker (valid.cxx:106) aborts in compute_interp_error because
# test_data's outer boundary is invalid. That machinery is unrelated to the
# smooth A/B and is not compared here, so we override ONLY the test_data group
# back to a real (neumann) outer BC. get_group_boundaries can only override a
# group TO a real BC, never TO none -- which is why the smooth group must stay
# on the global none rather than the reverse. See mp_noise_5.md.
CarpetX::neumann_x_vars       = "CapyrX_TestMultiPatch::test_data"
CarpetX::neumann_y_vars       = "CapyrX_TestMultiPatch::test_data"
CarpetX::neumann_z_vars       = "CapyrX_TestMultiPatch::test_data"
CarpetX::neumann_upper_x_vars = "CapyrX_TestMultiPatch::test_data"
CarpetX::neumann_upper_y_vars = "CapyrX_TestMultiPatch::test_data"
CarpetX::neumann_upper_z_vars = "CapyrX_TestMultiPatch::test_data"

CapyrX_TestMultiPatch::smooth_field = "parabola"
CapyrX_TestMultiPatch::run_outer_bc_tests = yes

IO::parfile_write = no
IO::out_dir       = $parfile
IO::out_every     = 1

CarpetX::out_performance = no
CarpetX::out_metadata    = no

CarpetX::out_tsv = yes
CarpetX::out_tsv_vars = "
  CoordinatesX::vertex_coords
  CapyrX_TestMultiPatch::smooth
  CapyrX_TestMultiPatch::smooth_pre
"
