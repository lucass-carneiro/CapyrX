# Parameter definitions for thorn CapyrX_TestMultiPatch


KEYWORD test_data "Analytical data to use in testing"
{
  "standing wave" :: "Standing wave"
  "parabola" :: "Parabola"
} "standing wave"

CCTK_REAL A "Standing wave amplitude"
{
  *:* :: ""
} 1.0

CCTK_REAL kx "standing wave kx"
{
  *:* :: ""
} 1.0

CCTK_REAL ky "standing wave ky"
{
  *:* :: ""
} 1.0

CCTK_REAL kz "standing wave kz"
{
  *:* :: ""
} 1.0

# The NaN-injection test intentionally writes NaN into nan_test, which trips
# CarpetX's hardcoded validity check and aborts the run whenever
# poison_undefined_values=yes (see carpetx_nan_checker_bug). That makes the two
# boundary diagnostics incompatible with the poison=yes coloring test, so they
# are OFF by default: color.par et al. run to completion, while the
# nan_*/smooth_* par files opt in explicitly (they set poison_undefined_values=no
# to tolerate the injected NaN).
#
# THE DIAGNOSTICS THEMSELVES NOW LIVE IN CapyrX_TestOuterBC, and ACTIVATING
# THAT THORN IS THE REAL SWITCH.  This parameter is kept because every existing
# par file sets it: CapyrX_TestMultiPatch_Check_Parameters refuses at PARAMCHECK
# when it is set while CapyrX_TestOuterBC is inactive, and names the line to
# add, so an un-migrated par file fails by name instead of silently producing no
# diagnostic output.
BOOLEAN run_outer_bc_tests "Run the outer-boundary NaN-injection and smooth-field (Channel 1) A/B diagnostics -- requires CapyrX_TestOuterBC in ActiveThorns"
{
} "no"
