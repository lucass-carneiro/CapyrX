# Parameter definitions for thorn CapyrX_WaveToy

KEYWORD initial_condition "Initial condition"
{
  "standing wave" :: "Standing wave"
  "Gaussian" :: "Gaussian"
  "Quadrupolar Gaussian" :: "Gaussian with a quadrupole moment that can be placed anywhere on the grid"
} "standing wave"

BOOLEAN add_dissipation "Add Kreiss-Oliger dissipation"
{
} no

CCTK_REAL cart_diss_eps "Kreiss-Oliger dissipation strength on Cartesian patches, used in every direction"
{
  0.0:*
} 0.15

CCTK_REAL curv_diss_eps_a "KO dissipation strength along the local a direction of curvilinear patches, relative to the local physical spacing h_min"
{
  0.0:*
} 0.15

CCTK_REAL curv_diss_eps_b "KO dissipation strength along the local b direction of curvilinear patches, relative to the local physical spacing h_min"
{
  0.0:*
} 0.15

CCTK_REAL curv_diss_eps_c "KO dissipation strength along the local c direction of curvilinear patches, relative to the local physical spacing h_min"
{
  0.0:*
} 0.15

CCTK_REAL diss_max_step_damping "Upper bound on dt * sum_d R_d (per-step damping of the grid-scale mode); the KO rates are scaled down uniformly wherever it is exceeded"
{
  (0.0:*
} 1.0

BOOLEAN use_newradx "Use radiative boundary conditions"
{
} "no"

CCTK_REAL rad_power "Rad. power parameter for NewRadX"
{
  0.0:* :: ""
} 1.0

CCTK_REAL amplitude "Initial amplitude for gaussian and wave initial data"
{
  *:* :: ""
} 1.0

CCTK_REAL wave_kx "kx wave number for wave initial data"
{
  *:* :: ""
} 1.0

CCTK_REAL wave_ky "ky wave number for wave initial data"
{
  *:* :: ""
} 1.0

CCTK_REAL wave_kz "kz wave number for wave initial data"
{
  *:* :: ""
} 1.0

CCTK_REAL gaussian_width "width of Gaussian"
{
  (0:* :: ""
} 1.0

CCTK_REAL gaussian_R0 "Gaussian radius"
{
  *:* :: ""
} 1.0

CCTK_REAL quad_gaussian_x0 "quadrupolar Gaussian x0"
{
  *:* :: ""
} 0.0

CCTK_REAL quad_gaussian_y0 "quadrupolar Gaussian y0"
{
  *:* :: ""
} 0.0

CCTK_REAL quad_gaussian_z0 "quadrupolar Gaussian z0"
{
  *:* :: ""
} 0.0