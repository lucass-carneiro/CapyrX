# Schedule definitions for thorn CapyrX_WaveToy

STORAGE: state rhs energy error

# Sync
SCHEDULE CapyrX_WaveToy_Sync IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Sync the scalar wave state"



# Init
SCHEDULE CapyrX_WaveToy_Initial IN ODESolvers_Initial
{
  LANG: C
  READS: CoordinatesX::vertex_coords(everywhere)
  WRITES: state(everywhere)
} "Initialize scalar wave state"



# Step
SCHEDULE CapyrX_WaveToy_RHS IN ODESolvers_RHS
{
  LANG: C
  READS: state(everywhere)
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: MultiPatch::vertex_Jacobians(everywhere)
  WRITES: rhs(interior)
} "Calculate scalar wave RHS"

if (add_dissipation)
{
  SCHEDULE CapyrX_WaveToy_Dissipation IN ODESolvers_RHS AFTER CapyrX_WaveToy_RHS
  {
    LANG: C
    READS: MultiPatch::vertex_Jacobians(everywhere)
    READS: state(everywhere)
    READS: rhs(interior)
    WRITES: rhs(interior)
  } "Add KO dissipation to the scalar wave RHS"

  # The KO rates depend only on the grid, the parameters and dt, so where they
  # are clamped (diss_max_step_damping) is checked once per BASEGRID traversal:
  # initial grid, every regrid and recovery.
  SCHEDULE GROUP CapyrX_WaveToy_DissipationCheckGroup AT basegrid \
     AFTER CapyrX_MultiPatch_Coordinates_Setup
  {
  } "Check where the KO dissipation rates are clamped"

  SCHEDULE CapyrX_WaveToy_reset_dissipation_check IN CapyrX_WaveToy_DissipationCheckGroup
  {
    LANG: C
    OPTIONS: global
  } "Reset the KO dissipation clamp diagnostics"

  SCHEDULE CapyrX_WaveToy_check_dissipation IN CapyrX_WaveToy_DissipationCheckGroup \
     AFTER CapyrX_WaveToy_reset_dissipation_check
  {
    LANG: C
    READS: MultiPatch::vertex_Jacobians(interior)
  } "Find the points where the KO dissipation rates are clamped"

  SCHEDULE CapyrX_WaveToy_report_dissipation_check IN CapyrX_WaveToy_DissipationCheckGroup \
     AFTER CapyrX_WaveToy_check_dissipation
  {
    LANG: C
    OPTIONS: global
  } "Warn about clamped KO dissipation rates"
}

if (use_newradx && add_dissipation)
{
  SCHEDULE CapyrX_WaveToy_ApplyNewRadX IN ODESolvers_RHS AFTER CapyrX_WaveToy_Dissipation
  {
    LANG: C
    READS: CoordinatesX::vertex_coords(interior)
    READS: MultiPatch::vertex_Jacobians(interior)
    READS: state(interior)
    READS: rhs(interior)
    WRITES: rhs(interior)
  } "Apply NewRadX boundary condition"
}

if (use_newradx && !add_dissipation)
{
  SCHEDULE CapyrX_WaveToy_ApplyNewRadX IN ODESolvers_RHS AFTER CapyrX_WaveToy_RHS
  {
    LANG: C
    READS: CoordinatesX::vertex_coords(interior)
    READS: MultiPatch::vertex_Jacobians(interior)
    READS: state(interior)
    READS: rhs(interior)
    WRITES: rhs(interior)
  } "Apply NewRadX boundary condition"
}



# Energy
SCHEDULE CapyrX_WaveToy_Energy AT analysis
{
  LANG: C
  READS: ADMBaseX::metric(everywhere)
  READS: state(everywhere)
  WRITES: energy(everywhere)
} "Calculate the energy density of the scalar wave equation"



# Evolution error
if (CCTK_EQUALS(initial_condition, "standing wave"))
{
  SCHEDULE CapyrX_WaveToy_Error AT analysis
  {
    LANG: C
    READS: CoordinatesX::vertex_coords(everywhere) state(everywhere)
    WRITES: error(everywhere)
  } "Calculate error in scalar wave evolution"
}
